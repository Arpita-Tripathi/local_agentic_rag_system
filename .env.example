# Copy to .env and fill in. Never commit .env.

# Answer mode: local (default) or cloud. Cloud still needs your explicit consent in the app.
# RAG_MODE=local

# Local model (default mode)
RAG_MODEL_DIR=./models
RAG_LITERT_MODEL=gemma-4-E4B-it

# Optional cloud mode (only used after explicit user consent)
# OPENROUTER_API_KEY=
# RAG_CLOUD_MODEL=

# OCR (scanned pages). Needs the Tesseract program with Hindi + English language data.
# RAG_OCR_LANGS=hin+eng
# RAG_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Layout parser for table-heavy PDFs: off | auto | on  (needs: pip install docling)
# RAG_LAYOUT=auto

# Where caches, summaries and the run log live (default ./index_cache)
# RAG_CACHE_DIR=./index_cache

# The run log (index_cache/runs.jsonl) records each question. Set to 0 to store only a hash.
# RAG_LOG_QUESTIONS=1

# Embedding model for retrieval (default: paraphrase-multilingual-MiniLM-L12-v2, about 470 MB on first use).
# All-English documents can use the smaller all-MiniLM-L6-v2, but then also raise RAG_SCORE_THRESHOLD.
# RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Passages scoring below this cosine similarity are dropped before the model is asked (0 to 1).
# RAG_SCORE_THRESHOLD=0.20
