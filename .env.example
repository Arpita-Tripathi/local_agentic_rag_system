# Copy to .env and fill in. Never commit .env.

# Local model (default mode)
RAG_MODEL_DIR=./models
RAG_LITERT_MODEL=gemma-4-E4B-it

# Optional cloud mode (only used after explicit user consent)
# OPENROUTER_API_KEY=
# RAG_CLOUD_MODEL=

# OCR (scanned pages). Needs the Tesseract program with Hindi + English language data.
# RAG_OCR_LANGS=hin+eng
# RAG_TESSERACT_CMD=C:\Program Files\Tesseract-OCR	esseract.exe

# Layout parser for table-heavy PDFs: off | auto | on  (needs: pip install docling)
# RAG_LAYOUT=auto
